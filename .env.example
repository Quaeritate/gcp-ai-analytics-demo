# Reference values only: the CLI does NOT load .env.
# Pass --project, --dataset and --location explicitly as documented.
# Authentication uses Application Default Credentials, never API keys.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=operations_insights
BIGQUERY_LOCATION=US

# Reviewed Gemini model/location and request/query limits are fixed in code.
# See docs/security-and-costs.md; environment variables do not override limits.
